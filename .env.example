# ============================================================
#  UniStay – Local Environment Variables Example
#  Copy this file to .env and fill in your real values.
#  ⚠️  Never commit .env to Git!
# ============================================================

# Neon PostgreSQL JDBC URL
# Format: jdbc:postgresql://<host>/<dbname>?sslmode=require
DB_URL=jdbc:postgresql://<your-neon-host>.neon.tech/neondb?sslmode=require

# Neon database username (typically your Neon project's role name)
DB_USERNAME=neondb_owner

# Neon database password
DB_PASSWORD=npg_xRM9vsgNkfr0

# ============================================================
# Admin Panel Credentials
# Set these to enable Admin Dashboard access
# ============================================================
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=admin123

