# ============================================================
#  UniStay – .gitignore
# ============================================================

# --- Secrets / Environment Variables (NEVER commit these) ---
.env
.env.*
!.env.example

# --- Spring Boot application.properties with hardcoded secrets ---
backend/src/main/resources/application.properties

# --- Startup scripts (contain hardcoded passwords and API keys) ---
backend/start.bat
backend/start-backend.bat

# --- Maven build outputs ---
target/
backend/target/
*.jar
*.war
*.class

# --- IDE / Editor files ---
.idea/
*.iml
.vscode/
*.swp
*.swo

# --- OS noise ---
.DS_Store
Thumbs.db

# --- Spring Boot DevTools ---
spring-devtools.properties

# --- Log files ---
*.log
logs/

# --- Node.js / npm ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

